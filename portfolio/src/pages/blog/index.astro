---
import Layout from '../../layouts/Layout.astro';
import { getSortedBlogs, formatDate, getReadingTime } from '../../lib/blog';

const blogs = await getSortedBlogs();
---

<Layout title="Blog | Pavan Patil" description="Writing on robotics, autonomous systems, ROS2, and field engineering.">
    <main id="main" class="mx-auto min-h-screen max-w-5xl px-6 py-20">
      <h1 class="text-4xl font-bold text-lightest-slate md:text-5xl">Blog</h1>
      <p class="mt-2 mb-12 text-slate">Thoughts, tutorials, and projects</p>

      {blogs.length === 0 ? (
        <p class="text-light-slate">No blog posts yet. Check back soon!</p>
      ) : (
        <div class="space-y-6">
          {blogs.map((post) => (
            <article class="border-l-4 border-accent pl-6 py-4 transition hover:bg-light-navy/50">
              <div class="flex flex-wrap items-center gap-3 mb-1">
                <time class="font-mono text-xs text-accent" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span class="font-mono text-xs text-slate">·</span>
                <span class="font-mono text-xs text-slate">{getReadingTime(post.body)}</span>
                <span class="font-mono text-xs text-slate">·</span>
                <span class="font-mono text-xs text-slate">
                  <span class="goatcounter-count" data-path={`/blog/${post.id}`}></span> views
                </span>
              </div>
              <h2 class="text-2xl font-semibold text-lightest-slate mb-2">
                <a href={`/blog/${post.id}`} class="transition hover:text-accent">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-light-slate mb-3">{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="inline-block rounded bg-lightest-navy px-3 py-1 font-mono text-xs text-accent">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      )}
    </main>
</Layout>
