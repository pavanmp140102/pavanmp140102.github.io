---
import { EMAIL as email } from '../lib/site';
---

<div class="fixed bottom-0 right-6 z-10 hidden flex-col items-center gap-5 xl:flex xl:right-10">
  <a
    href={`mailto:${email}`}
    class="font-mono text-xs tracking-widest text-slate transition-all hover:-translate-y-1 hover:text-accent"
    style="writing-mode: vertical-rl;"
  >
    {email}
  </a>
  <div class="h-24 w-px bg-slate"></div>
</div>
